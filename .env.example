# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- control plane ---
# Inside docker compose the hostnames are the service names (postgres, redis).
# From the host use localhost, since both ports are published.
DATABASE_URL=postgres://forgerun:forgerun@localhost:5432/forgerun?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Host ports docker compose publishes. Change these if something already listens
# on 5432/6379 on your machine, and update the two URLs above to match.
# ForgeRun needs Redis 6.2+ (it uses BLMOVE); an older host Redis on 6379 will
# shadow the container and fail with "unknown command blmove".
POSTGRES_PORT=5432
REDIS_PORT=6379
SERVER_PORT=8080
LOG_LEVEL=info

# Public URL of the API, used for GitHub status links and by the runner.
FORGERUN_SERVER_URL=http://localhost:8080

# --- github ---
# Secret configured on the webhook. Deliveries without a valid signature are refused.
GITHUB_WEBHOOK_SECRET=

# Authentication for outbound calls. A GitHub App is preferred: it mints
# short-lived, single-repository tokens, which is what makes checking out a
# private repository safe. Set the app id and one of the two key settings.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or inline the PEM instead of a file (use 
 for newlines in a .env file).
GITHUB_APP_PRIVATE_KEY=

# Fallback: a personal access token. Reports commit statuses, but cannot mint a
# clone credential, so private repositories need the App above. Leave everything
# empty to disable GitHub integration for local work.
GITHUB_TOKEN=

# --- runners ---
# Shared secret a runner must present to join the pool. Change it for anything
# beyond local development.
RUNNER_REGISTRATION_TOKEN=dev-registration-token
RUNNER_NAME=local-runner
RUNNER_LABELS=linux,amd64,docker
# A runner missing heartbeats for this long is marked OFFLINE and its job requeued.
HEARTBEAT_TIMEOUT=45s

# --- job execution limits (applied to every container) ---
JOB_TIMEOUT=10m
JOB_CPUS=1.0
JOB_MEMORY_MB=1024
# "none" means job containers have no network access at all.
DOCKER_NETWORK=none
DEFAULT_IMAGE=alpine:3.20
# Where the runner creates per-job workspaces (defaults to the system temp dir).
# WORKSPACE_ROOT=/tmp
